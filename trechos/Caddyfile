# Servidor web de produção. O Caddy obtém e renova o certificado HTTPS sozinho,
# desde que o domínio em DOMINIO aponte para este servidor e as portas 80 e 443 estejam abertas.
{$DOMINIO} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Só carrega scripts do próprio site. Os estilos embutidos são usados pela biblioteca de componentes.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; frame-ancestors 'none'"
		-Server
	}

	# A API é a única parte do backend exposta para fora.
	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv

		# Os arquivos em /assets têm o conteúdo no nome, então podem ficar guardados no navegador.
		@arquivos_com_hash path /assets/*
		header @arquivos_com_hash Cache-Control "public, max-age=31536000, immutable"

		# A página em si nunca fica guardada, para o navegador pegar a versão nova após uma atualização.
		@pagina not path /assets/*
		header @pagina Cache-Control "no-cache"

		# Endereços como /produtos são tratados pelas telas, então devolvem a página inicial.
		try_files {path} /index.html
		file_server
	}
}
